# Application configuration
PROJECT_NAME=SIH Tourist Safety
PROJECT_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database (SQLite local file; relative to the working/backend directory)
DATABASE_URL=sqlite:///./tourist_safety.db

# JWT signing for the tourist digital ID
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
